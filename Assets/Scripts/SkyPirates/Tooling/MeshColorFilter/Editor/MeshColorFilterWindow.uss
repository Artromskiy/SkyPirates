.content-scroll { flex-grow: 1; }
.window-root { padding: 10px; }
.title { unity-font-style: bold; font-size: 18px; margin-bottom: 8px; }
.row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.row > ObjectField { flex-grow: 1; }
.row > Button { margin-left: 4px; }
.rules-host { margin-top: 8px; margin-bottom: 8px; }
.rule-header { flex-direction: row; align-items: center; }
.rule-header > Toggle { min-width: 84px; }
.rule-title { unity-font-style: bold; flex-grow: 1; }
.primary-button { height: 34px; margin-top: 8px; margin-bottom: 8px; }
.highlight-preview-host { min-height: 160px; }
.preview-resize-handle { height: 6px; flex-shrink: 0; margin-top: 4px; margin-bottom: 4px; background-color: #555; }
.preview-resize-handle:hover { background-color: #888; }
