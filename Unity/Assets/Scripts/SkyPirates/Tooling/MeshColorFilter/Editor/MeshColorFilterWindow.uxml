<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="MeshColorFilterWindow.uss" />
    <ui:ScrollView name="content-scroll" class="content-scroll">
        <ui:VisualElement class="window-root">
            <ui:Label text="Mesh Color Filter" class="title" />
            <ui:VisualElement class="row">
                <uie:ObjectField name="profile-field" label="Profile" />
                <ui:Button name="create-profile" text="New Profile" />
            </ui:VisualElement>
            <uie:ObjectField name="source-field" label="Source prefab or model" />
            <ui:DropdownField name="renderer-field" label="Renderer" />
            <ui:Foldout name="highlight-foldout" text="Match preview" value="true">
                <ui:EnumField name="preview-mode" label="Shading mode" />
                <ui:VisualElement name="highlight-preview-host" class="highlight-preview-host" />
                <ui:VisualElement name="preview-resize-handle" class="preview-resize-handle" />
            </ui:Foldout>
            <ui:VisualElement name="rules-host" class="rules-host" />
            <ui:EnumField name="triangle-mode" label="Triangle assignment" />
            <ui:IntegerField name="split-depth" label="Adaptive split depth" />
            <ui:Button name="process-button" text="Create New Prefab" class="primary-button" />
            <ui:HelpBox name="status" text="Select a profile and a prefab or imported model." />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
