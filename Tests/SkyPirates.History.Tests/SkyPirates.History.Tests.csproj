<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shared/SkyPirates.Shared.csproj" />
    <PackageReference Include="DeltaECS.Generators" Version="0.0.63" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../Shared/Resources/**/*">
      <Link>Resources/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
