<Project>
    <PropertyGroup>
        <!-- In the monorepo checkout, keep generated C# files outside Unity Assets. -->
        <BaseIntermediateOutputPath Condition="Exists('$(MSBuildThisFileDirectory)../Unity/ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../Unity/Temp/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
        <MSBuildProjectExtensionsPath Condition="Exists('$(MSBuildThisFileDirectory)../Unity/ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../Unity/Temp/obj/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
        <BaseOutputPath Condition="Exists('$(MSBuildThisFileDirectory)../Unity/ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../Unity/Temp/bin/$(MSBuildProjectName)/</BaseOutputPath>
    </PropertyGroup>
</Project>
